{
  "name": "bare-posix",
  "version": "1.0.1",
  "description": "POSIX-specific bindings for Bare",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "android": "./unsupported.js",
      "win32": "./unsupported.js",
      "default": "./index.js"
    },
    "./package": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "unsupported.js",
    "binding.c",
    "binding.js",
    "CMakeLists.txt",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-posix.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-posix/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-posix#readme",
  "devDependencies": {
    "brittle": "^3.19.1",
    "cmake-bare": "^1.7.7",
    "lunte": "^1.6.0",
    "prettier": "^3.8.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
